{
  "name": "@f3nation/health",
  "version": "1.1.0",
  "private": false,
  "type": "module",
  "description": "F3 health contract schemas and helper utilities for building and consuming /health endpoints.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/F3-Nation/f3-nation.git",
    "directory": "packages/health"
  },
  "homepage": "https://github.com/F3-Nation/f3-nation/tree/main/packages/health",
  "bugs": {
    "url": "https://github.com/F3-Nation/f3-nation/issues"
  },
  "keywords": [
    "f3",
    "health",
    "status"
  ],
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf .turbo node_modules",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "lint": "eslint .",
    "prepack": "pnpm build",
    "test": "vitest --run --coverage",
    "test:watch": "vitest -w",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@acme/eslint-config": "workspace:*",
    "@acme/prettier-config": "workspace:*",
    "@acme/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "prettier": "@acme/prettier-config"
}
