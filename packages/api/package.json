{
  "name": "@acme/api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./services/map-request-notification": "./src/services/map-request-notification.ts"
  },
  "license": "MIT",
  "scripts": {
    "clean": "rm -rf .turbo node_modules",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "lint": "eslint .",
    "test": "pnpm with-env vitest --run --coverage",
    "test:org-hierarchy": "pnpm with-env tsx src/scripts/test-org-hierarchy.ts",
    "test:watch": "pnpm with-env vitest -w",
    "typecheck": "tsc --noEmit",
    "with-env": "dotenv -e ../env/.env --"
  },
  "dependencies": {
    "@acme/auth": "workspace:^0.1.0",
    "@acme/db": "workspace:^0.1.0",
    "@acme/env": "workspace:^0.1.0",
    "@acme/logger": "workspace:*",
    "@acme/mail": "workspace:*",
    "@acme/shared": "workspace:^0.1.0",
    "@acme/validators": "workspace:^0.1.0",
    "@orpc/client": "catalog:",
    "@orpc/experimental-ratelimit": "catalog:",
    "@orpc/server": "catalog:",
    "dayjs": "catalog:",
    "drizzle-orm": "catalog:",
    "google-auth-library": "catalog:",
    "jose": "catalog:",
    "lodash": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "next": ">=15.5.18 <16",
    "react": ">=18 <19",
    "react-dom": ">=18 <19"
  },
  "devDependencies": {
    "@acme/eslint-config": "workspace:^0.2.0",
    "@acme/prettier-config": "workspace:^0.1.0",
    "@acme/tsconfig": "workspace:^0.1.0",
    "@types/lodash": "catalog:",
    "@types/nodemailer": "^6.4.17",
    "@types/uuid": "^11.0.0",
    "@vitest/coverage-v8": "catalog:",
    "dotenv-cli": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "vitest": "catalog:"
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@acme/eslint-config/base"
    ],
    "ignorePatterns": [
      "vitest.config.ts"
    ]
  },
  "prettier": "@acme/prettier-config"
}
