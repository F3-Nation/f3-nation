{
  "name": "@acme/api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./services/map-request-notification": "./src/services/map-request-notification.ts"
  },
  "license": "MIT",
  "scripts": {
    "clean": "rm -rf .turbo node_modules",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "lint": "eslint .",
    "test": "pnpm with-env vitest --run",
    "test:org-hierarchy": "pnpm with-env tsx src/scripts/test-org-hierarchy.ts",
    "test:watch": "pnpm with-env vitest -w",
    "typecheck": "tsc --noEmit",
    "with-env": "dotenv -e ../env/.env --"
  },
  "dependencies": {
    "@acme/auth": "workspace:^0.1.0",
    "@acme/db": "workspace:^0.1.0",
    "@acme/env": "workspace:^0.1.0",
    "@acme/mail": "workspace:*",
    "@acme/shared": "workspace:^0.1.0",
    "@acme/validators": "workspace:^0.1.0",
    "@orpc/client": "^1.8.8",
    "@orpc/experimental-ratelimit": "^1.13.2",
    "@orpc/server": "^1.8.8",
    "axios": "^1.7.4",
    "dayjs": "^1.11.10",
    "google-auth-library": "^10.3.0",
    "jose": "^6.2.1",
    "lodash": "^4.17.21",
    "superjson": "2.2.1",
    "zod": "^3.25.8"
  },
  "peerDependencies": {
    "next": ">=14",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@acme/eslint-config": "workspace:^0.2.0",
    "@acme/prettier-config": "workspace:^0.1.0",
    "@acme/tsconfig": "workspace:^0.1.0",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  },
  "prettier": "@acme/prettier-config"
}
