NODE_ENV=development

# Local Docker Postgres (started by pnpm docker:up)
# This file configures the @acme/db CLI scripts only (migrate, seed, reset,
# drizzle-kit, reset-test-db). The app services (apps/api, apps/map, ...) read
# their own app .env and never read this file.
#
# DATABASE_URL is used by migrate.ts directly (always, even under NODE_ENV=test)
# and by seed/reset/drizzle-kit for the normal, non-test database.
DATABASE_URL=postgresql://f3local:f3local@localhost:5433/f3nation
# TEST_DATABASE_URL is the test-only override. The DATABASE_URL -> TEST_DATABASE_URL
# switch happens in getDbUrl() (src/utils/functions.ts) when NODE_ENV === "test",
# used by reset-test-db and reset. Keep it on the dedicated local test database,
# not the normal dev database.
TEST_DATABASE_URL=postgresql://f3local:f3local@localhost:5433/f3nation_test
SKIP_ENV_VALIDATION=1
