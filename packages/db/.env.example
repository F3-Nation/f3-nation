NODE_ENV=development

# Local Docker Postgres (started by pnpm docker:up)
# DATABASE_URL is the normal database connection used by migrations and local
# app/dev startup when NODE_ENV is not "test".
DATABASE_URL=postgresql://f3local:f3local@localhost:5433/f3nation
# TEST_DATABASE_URL is a test-only override. It is selected automatically by
# packages/db/src/utils/functions.ts when NODE_ENV === "test" (for example,
# reset-test-db and other test flows). Keep it pointed at the dedicated local
# test database, not the normal dev database.
TEST_DATABASE_URL=postgresql://f3local:f3local@localhost:5433/f3nation_test
SKIP_ENV_VALIDATION=1
