NODE_ENV=development

# Local Docker Postgres (started by pnpm docker:up)
# DATABASE_URL is the default database connection used by DB package scripts
# (migrations, reset, seed, and local testing) when NODE_ENV != "test".
DATABASE_URL=postgresql://f3local:f3local@localhost:5433/f3nation
# TEST_DATABASE_URL is the test-only override used by DB package test flows and
# reset helpers. Keep it pointed at the dedicated local test database, not the
# normal dev database.
TEST_DATABASE_URL=postgresql://f3local:f3local@localhost:5433/f3nation_test
SKIP_ENV_VALIDATION=1
