{
  "name": "@acme/db",
  "version": "0.6.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./testing": "./src/utils/reset-test-db.ts",
    "./schema/schema": "./drizzle/schema.ts",
    "./schema/relations": "./drizzle/relations.ts"
  },
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "clean": "rm -rf .turbo node_modules",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "lint": "eslint .",
    "push": "pnpm with-env drizzle-kit push",
    "pull": "pnpm with-env drizzle-kit pull",
    "generate": "pnpm with-env drizzle-kit generate",
    "generate:empty": "pnpm with-env drizzle-kit generate --custom",
    "migrate": "QUERY_TIMEOUT_MS=0 pnpm with-env node -r esbuild-register src/migrate.ts",
    "reset": "QUERY_TIMEOUT_MS=0 pnpm with-env tsx ./src/reset.ts",
    "seed": "QUERY_TIMEOUT_MS=0 pnpm with-env node -r esbuild-register src/seed.ts",
    "studio": "pnpm with-env drizzle-kit studio",
    "drop": "pnpm with-env drizzle-kit drop",
    "reset-test-db": "QUERY_TIMEOUT_MS=0 SKIP_ENV_VALIDATION=1 NODE_ENV=test pnpm with-env node -r esbuild-register src/utils/run-reset-test-db.ts",
    "seed:local": "QUERY_TIMEOUT_MS=0 pnpm with-env tsx src/local-seed.ts",
    "typecheck": "tsc --noEmit",
    "with-env": "dotenv -e ../env/.env --",
    "update-db": "QUERY_TIMEOUT_MS=0 pnpm with-env node -r esbuild-register src/update-db.ts"
  },
  "dependencies": {
    "@acme/env": "workspace:*",
    "@acme/shared": "workspace:*",
    "dayjs": "catalog:",
    "dotenv-cli": "catalog:",
    "drizzle-orm": "catalog:",
    "esbuild-register": "catalog:",
    "pg": "catalog:",
    "pg-connection-string": "catalog:",
    "postgres": "catalog:"
  },
  "devDependencies": {
    "@acme/eslint-config": "workspace:*",
    "@acme/prettier-config": "workspace:*",
    "@acme/tsconfig": "workspace:*",
    "drizzle-kit": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "prettier": "@acme/prettier-config"
}
