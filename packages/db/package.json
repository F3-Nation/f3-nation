{
  "name": "@acme/db",
  "version": "0.1.3",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./schema/schema": "./drizzle/schema.ts",
    "./schema/relations": "./drizzle/relations.ts"
  },
  "license": "MIT",
  "scripts": {
    "clean": "rm -rf .turbo node_modules",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "lint": "eslint .",
    "push": "pnpm with-env drizzle-kit push",
    "pull": "pnpm with-env drizzle-kit pull",
    "generate": "pnpm with-env drizzle-kit generate",
    "generate:empty": "pnpm with-env drizzle-kit generate --custom",
    "migrate": "pnpm with-env node -r esbuild-register src/migrate.ts",
    "reset": "pnpm with-env tsx ./src/reset.ts",
    "seed": "pnpm with-env node -r esbuild-register src/seed.ts",
    "studio": "pnpm with-env drizzle-kit studio",
    "drop": "pnpm with-env drizzle-kit drop",
    "reset-test-db": "SKIP_ENV_VALIDATION=1 NODE_ENV=test pnpm with-env node -r esbuild-register src/utils/run-reset-test-db.ts",
    "seed:local": "pnpm with-env tsx src/local-seed.ts",
    "test": "pnpm with-env vitest --run --coverage",
    "test:watch": "pnpm with-env vitest -w",
    "typecheck": "tsc --noEmit",
    "with-env": "dotenv -e ../env/.env --",
    "update-db": "pnpm with-env node -r esbuild-register src/update-db.ts",
    "convert-legacy-edits": "pnpm with-env node -r esbuild-register src/convert-legacy-edit-requests.ts"
  },
  "dependencies": {
    "@acme/env": "workspace:*",
    "@acme/shared": "workspace:*",
    "dayjs": "catalog:",
    "dotenv-cli": "catalog:",
    "drizzle-orm": "catalog:",
    "esbuild-register": "catalog:",
    "pg": "catalog:",
    "pg-connection-string": "catalog:",
    "postgres": "catalog:"
  },
  "devDependencies": {
    "@acme/eslint-config": "workspace:*",
    "@acme/prettier-config": "workspace:*",
    "@acme/tsconfig": "workspace:*",
    "@vitest/coverage-v8": "catalog:",
    "drizzle-kit": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "prettier": "@acme/prettier-config"
}
