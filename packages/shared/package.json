{
  "name": "@acme/shared",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "main": "./index.ts",
  "types": "./index.ts",
  "license": "MIT",
  "exports": {
    "./app/*": [
      "./src/app/*.ts",
      "./src/app/*.tsx"
    ],
    "./common/*": "./src/common/*.ts"
  },
  "scripts": {
    "clean": "rm -rf .turbo node_modules",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "lint": "eslint .",
    "lint:fix": "yarn lint --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lodash": "catalog:",
    "next-auth": "catalog:",
    "zod": "catalog:",
    "zustand": "catalog:"
  },
  "peerDependencies": {
    "react": ">=18 <19"
  },
  "devDependencies": {
    "@acme/eslint-config": "workspace:^0.2.0",
    "@acme/prettier-config": "workspace:^0.1.0",
    "@acme/tsconfig": "workspace:^0.1.0",
    "@types/lodash": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:"
  },
  "prettier": "@acme/prettier-config"
}
