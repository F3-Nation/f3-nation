{
  "$schema": "https://turborepo.org/schema.json",
  "globalDependencies": [
    "**/.env",
    ".github/workflows/ci.yml",
    ".gitignore",
    ".nvmrc",
    ".prettierignore",
    ".python-version",
    "apps/*/Dockerfile",
    "pyproject.toml",
    "uv.lock",
    "scripts/python-task.sh"
  ],
  "globalPassThroughEnv": [
    "ALLOW_DEV_MOCK_SESSION",
    "F3_ADMIN_PORT",
    "F3_AUTH_PORT",
    "F3_CONTAINER_PREFIX",
    "F3_HOMEPAGE_PORT",
    "F3_MAP_PORT",
    "F3_ME_PORT",
    "GITHUB_SHA",
    "INIT_CWD",
    "SNAPSHOT_CALLER_CWD"
  ],
  "globalEnv": [
    "CI",
    "NODE_ENV",
    "LOG_LEVEL",
    "SKIP_ENV_VALIDATION",
    "SKIP_SSG",
    "DATABASE_URL",
    "DATABASE_HOST",
    "DATABASE_PORT",
    "DATABASE_USER",
    "DATABASE_PASSWORD",
    "DATABASE_NAME",
    "TEST_DATABASE_URL",
    "SKIP_RESET_TEST_DB",
    "QUERY_TIMEOUT_MS",
    "E2E_BASE_URL",
    "E2E_API_URL",
    "E2E_AUDIT_LOCAL",
    "CHAR_TEST_TARGET",
    "CHAR_TEST_BASE_URL",
    "CHAR_TEST_SHARED_DB",
    "CHAR_TEST_SIGNING_JWK",
    "SUPER_ADMIN_API_KEY",
    "EMAIL_ADMIN_DESTINATIONS",
    "EMAIL_FROM",
    "EMAIL_SERVER",
    "AUTH_DISCORD_ID",
    "AUTH_DISCORD_SECRET",
    "AUTH_PROVIDER_URL",
    "AUTH_REDIRECT_PROXY_URL",
    "AUTH_SECRET",
    "AUTH_JWT_PRIVATE_KEY",
    "AUTH_USE_BETTER_AUTH",
    "OAUTH_CLIENT_ID",
    "OAUTH_CLIENT_SECRET",
    "OAUTH_REDIRECT_URI",
    "F3_ADMIN_BASE_URL",
    "F3_API_BASE_URL",
    "F3_API_HOST",
    "F3_ADMIN_URL",
    "F3_API_TIMEOUT_MS",
    "F3_CHANNEL",
    "F3_GOOGLE_API_KEY",
    "F3_MAP_BASE_URL",
    "PORT",
    "NEXT_RUNTIME",
    "npm_lifecycle_event",
    "NEXT_PUBLIC_ADMIN_URL",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_AUTH_URL",
    "NEXT_PUBLIC_MAP_URL",
    "NEXT_PUBLIC_CHANNEL",
    "NEXT_PUBLIC_POSTHOG_KEY",
    "NEXT_PUBLIC_POSTHOG_SESSION_RECORDING",
    "GCS_CREDENTIALS",
    "GCS_EMULATOR_HOST",
    "NODE_TLS_REJECT_UNAUTHORIZED",
    "CI_FACTORY_INFERENCE_API_KEY",
    "CI_FACTORY_INFERENCE_BASE_URL",
    "CI_FACTORY_INFERENCE_MODEL",
    "UV_PYTHON"
  ],
  "tasks": {
    "topo": {
      "dependsOn": ["^topo"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "next-env.d.ts", "dist/**"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "format": {
      "outputs": [],
      "outputLogs": "full"
    },
    "lint": {
      "dependsOn": ["^topo"]
    },
    "reset-test-db": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^topo"]
    },
    "test": {
      "dependsOn": ["^topo"],
      "env": ["PATH"],
      "outputs": ["coverage/**"]
    },
    "test:characterization": {
      "dependsOn": ["^topo", "reset-test-db", "^reset-test-db", "test"],
      "env": [
        "CHAR_TEST_AUTH_ISSUER",
        "CHAR_TEST_AUTH_PROVIDER_URL",
        "CHAR_TEST_AUTH_CLIENT_ID",
        "CHAR_TEST_AUTH_CLIENT_SECRET",
        "CHAR_TEST_AUTH_USER_TOKEN",
        "CHAR_TEST_AUTH_USER_CLIENT_ID"
      ],
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "obfuscate-db": {
      "cache": false,
      "env": ["OBFUSCATION_SALT", "OBFUSCATE_VERIFY_POSTGRES_IMAGE"]
    },
    "staging-refresh": {
      "cache": false,
      "env": [
        "OBFUSCATION_SALT",
        "PROD_DATABASE_URL",
        "STAGING_DATABASE_URL",
        "INTERMEDIATE_DATABASE_URL",
        "PG_BIN_DIR",
        "CLOUD_RUN_JOB"
      ]
    },
    "migrate:staging": {
      "cache": false,
      "env": [
        "MIGRATE_DATABASE_URL",
        "MIGRATE_SECRET",
        "MIGRATE_SECRET_PROJECT"
      ]
    },
    "migrate:prod": {
      "cache": false,
      "env": [
        "MIGRATE_DATABASE_URL",
        "MIGRATE_SECRET",
        "MIGRATE_SECRET_PROJECT"
      ]
    }
  }
}
