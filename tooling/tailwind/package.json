{
  "name": "@acme/tailwind-config",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "exports": {
    "./web.css": "./web.css"
  },
  "license": "MIT",
  "scripts": {
    "clean": "rm -rf .turbo node_modules",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
