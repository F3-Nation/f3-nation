{
  "name": "@acme/scripts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src"
  },
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "clean": "rm -rf .turbo node_modules",
    "lint": "eslint .",
    "lint:fix": "pnpm lint --fix",
    "format": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore",
    "notify-outstanding-requests": "pnpm with-env tsx ./src/notify-outstanding-requests.ts",
    "orphaned-event-series-backfill": "pnpm with-env tsx ./src/orphaned-event-series-backfill.ts",
    "test": "pnpm with-env vitest run",
    "script": "pnpm with-env tsx ./src/script.ts",
    "typecheck": "tsc --noEmit",
    "with-env": "dotenv -e ../../.env --"
  },
  "devDependencies": {
    "@acme/api": "workspace:*",
    "@acme/db": "workspace:*",
    "@acme/env": "workspace:*",
    "@acme/eslint-config": "workspace:*",
    "@acme/mail": "workspace:*",
    "@acme/prettier-config": "workspace:*",
    "@acme/shared": "workspace:*",
    "@acme/tsconfig": "workspace:*",
    "dotenv-cli": "catalog:",
    "drizzle-orm": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "prettier": "@acme/prettier-config"
}
