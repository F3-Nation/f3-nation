# Image for the f3-staging-refresh Cloud Run job (F3-65, docs/STAGING_REFRESH.md).
#
# Postgres 18 (the server for the throwaway obfuscation copy, plus the
# pg_dump/pg_restore 18 clients the refresh needs) with Node 24 and the
# @acme/scripts package run from source through tsx. Built from the repo root
# and deployed by tooling/scripts/staging-refresh/setup.sh:
#   docker build -f tooling/scripts/Dockerfile.staging-refresh .
ARG TURBO_VERSION=2

# glibc-based on purpose: the runner is Debian (postgres:18), and pnpm
# installs platform-specific binaries (esbuild, under tsx).
FROM node:24.22.1-trixie-slim@sha256:43b9ba1142b8dcf33fa8f922ca1be85714adc444e0586c7cf7726daaeabc1bea AS node

# ---------- Stage 1: prune the monorepo to @acme/scripts ----------
FROM node AS builder
ARG TURBO_VERSION
ENV TURBO_TELEMETRY_DISABLED=1
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
WORKDIR /app
RUN corepack enable && npm install -g turbo@${TURBO_VERSION}
COPY . .
RUN turbo prune @acme/scripts --docker

# ---------- Stage 2: install from the pruned lockfile ----------
FROM node AS installer
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
WORKDIR /app
RUN corepack enable
COPY --from=builder /app/out/json/ .
COPY --from=builder /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
RUN pnpm install --frozen-lockfile --ignore-scripts
COPY --from=builder /app/out/full/ .
# The migration gate checks prod's applied migrations against this build's
# journal (packages/db is not a dependency of @acme/scripts, so prune drops it).
COPY --from=builder /app/packages/db/drizzle/meta/_journal.json ./packages/db/drizzle/meta/_journal.json

# ---------- Stage 3: runner ----------
FROM postgres:18@sha256:74935e72241653ca55e0414067e6d8763aceb8a810eb51b452253ec3dcfc4336 AS runner
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=installer --chown=postgres:postgres /app /app
COPY tooling/scripts/staging-refresh/entrypoint.sh /usr/local/bin/staging-refresh
RUN chmod 755 /usr/local/bin/staging-refresh \
  && node --version && pg_dump --version \
  && cd /app/tooling/scripts && node -e "require.resolve('postgres'); require.resolve('tsx')"
# Postgres refuses to run as root; the whole job runs as the image's postgres user.
USER postgres
WORKDIR /app/tooling/scripts
ENTRYPOINT ["staging-refresh"]
