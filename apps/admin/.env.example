# =============================================================================
# F3 Admin — Local Development Environment (example)
# =============================================================================
# Don't edit this file directly. Run `pnpm local:setup` to auto-generate
# apps/admin/.env from this template.
#
# If you need manual setup, copy this file to .env and fill in values.

# Auth (F3 SSO — points to local auth server on :3004)
OAUTH_CLIENT_ID=f3-admin-local
OAUTH_CLIENT_SECRET=local-admin-client-secret
OAUTH_REDIRECT_URI=http://localhost:3002/api/auth/callback
AUTH_PROVIDER_URL=http://localhost:3004

# F3 Nation API (local API on :3001)
F3_API_BASE_URL=http://localhost:3001/v1

# Google Cloud Storage (logo uploads — uses local GCS emulator)
GCS_CREDENTIALS=local-placeholder-not-used-with-emulator
GCS_EMULATOR_HOST=localhost:9023

# App
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_MAP_URL=http://localhost:3000
NEXT_PUBLIC_CHANNEL=local
NODE_ENV=development

# Google Maps API key — required for map tiles in the admin UI.
# Get one free at: https://console.cloud.google.com/google/maps-apis/
# Leave blank to start the app without map tiles.
NEXT_PUBLIC_GOOGLE_API_KEY=your-google-maps-api-key-here

F3_GOOGLE_API_KEY=your-google-maps-api-key-here
F3_MAP_BASE_URL=http://localhost:3000
F3_ADMIN_BASE_URL=http://localhost:3002
F3_CHANNEL=local

# Logging
# Pino log level: trace | debug | info | warn | error | fatal (default: info).
# Verbose by default locally; raise it (e.g. info) to quiet the dev console.
LOG_LEVEL=debug