{
  "name": "f3-admin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm with-env next build",
    "clean": "rm -rf .turbo node_modules .next",
    "dev": "TZ=UTC pnpm with-env next dev -p 3002",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "lint": "dotenv -v SKIP_ENV_VALIDATION=1 eslint .",
    "start": "pnpm with-env next start",
    "typecheck": "tsc --noEmit",
    "with-env": "dotenv -e ../../.env --"
  },
  "dependencies": {
    "@acme/api": "workspace:^0.2.0",
    "@acme/mail": "workspace:*",
    "@acme/shared": "workspace:^0.1.0",
    "@acme/sso": "workspace:*",
    "@acme/storage": "workspace:^0.1.0",
    "@acme/tailwind-config": "workspace:^0.1.0",
    "@acme/ui": "workspace:^0.1.0",
    "@acme/validators": "workspace:^0.1.0",
    "@orpc/client": "^1.8.8",
    "@orpc/server": "^1.8.8",
    "@orpc/tanstack-query": "^1.8.8",
    "@react-hook/window-size": "^3.1.1",
    "@t3-oss/env-nextjs": "^0.9.2",
    "@tanstack/react-query": "5.90.12",
    "@tanstack/react-query-devtools": "^5.91.1",
    "@tanstack/react-virtual": "^3.13.6",
    "@vis.gl/react-google-maps": "^1.5.2",
    "axios": "^1.7.4",
    "dayjs": "^1.11.10",
    "dompurify": "^3.1.7",
    "dotenv-cli": "^7.3.0",
    "geist": "^1.2.2",
    "jose": "^6.2.1",
    "lodash": "^4.17.21",
    "next": "^15.3.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.50.1",
    "react-qr-code": "^2.0.15",
    "server-only": "^0.0.1",
    "superjson": "2.2.1",
    "uuid": "^11.0.5",
    "zod": "^3.25.8",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@acme/eslint-config": "workspace:^0.2.0",
    "@acme/prettier-config": "workspace:^0.1.0",
    "@acme/tsconfig": "workspace:*",
    "@types/dompurify": "^3.0.5",
    "@types/lodash": "^4.14.195",
    "@types/node": "^20.11.13",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "eslint": "catalog:",
    "jiti": "^2.4.2",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3"
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@acme/eslint-config/base",
      "@acme/eslint-config/nextjs",
      "@acme/eslint-config/react"
    ]
  },
  "prettier": "@acme/prettier-config"
}
