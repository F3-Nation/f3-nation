{
  "name": "f3-admin",
  "version": "1.2.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm with-env next build",
    "clean": "rm -rf .turbo node_modules .next",
    "dev": "TZ=UTC pnpm with-env next dev -p 3002",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "lint": "dotenv -v SKIP_ENV_VALIDATION=1 eslint .",
    "start": "pnpm with-env next start",
    "typecheck": "tsc --noEmit",
    "with-env": "dotenv -e ../../.env --"
  },
  "dependencies": {
    "@acme/api": "workspace:^0.2.0",
    "@acme/logger": "workspace:*",
    "@acme/mail": "workspace:*",
    "@acme/shared": "workspace:^0.1.0",
    "@acme/sso": "workspace:*",
    "@acme/storage": "workspace:*",
    "@acme/tailwind-config": "workspace:^0.1.0",
    "@acme/ui": "workspace:^0.1.0",
    "@acme/validators": "workspace:^0.1.0",
    "@orpc/client": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/tanstack-query": "catalog:",
    "@radix-ui/react-icons": "catalog:",
    "@t3-oss/env-nextjs": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-query-devtools": "catalog:",
    "@tanstack/react-table": "catalog:",
    "@vis.gl/react-google-maps": "catalog:",
    "dayjs": "catalog:",
    "dotenv-cli": "catalog:",
    "geist": "catalog:",
    "jose": "catalog:",
    "lodash": "catalog:",
    "lucide-react": "catalog:",
