# Set to "true" to redirect monorepo app cards to localhost ports instead of prod URLs.
NEXT_PUBLIC_LOCAL_DEV=true

# Read-only API key for the org-chart directory endpoints, sent as a Bearer
# token from the browser. NEXT_PUBLIC_* means it is baked into the static bundle
# and visible in devtools; it grants nothing beyond the public directory reads.
NEXT_PUBLIC_ORG_MAP_API_KEY=f3-org-map

# -- PostHog error tracking (optional) -----------------------------------------
# Browser error reporting only (no analytics); see
# packages/observability/src/browser.ts. Leave unset locally: unset or empty
# turns reporting off. Inlined at build time, so set it before `next build`.
# NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_key
