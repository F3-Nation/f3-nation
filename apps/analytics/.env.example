# Approved local live-run template; use only with explicit approval.
ANALYTICS_ENVIRONMENT=local
# Replace both blanks with the absolute values discovered by the README steps.
DUCKDB_EXTENSION_DIR=
DUCKDB_POSTGRES_EXTENSION_PATH=
# PostgreSQL host and port; leave ANALYTICS_POSTGRES_SOCKET_DIR unset.
ANALYTICS_POSTGRES_HOST=localhost
ANALYTICS_POSTGRES_PORT=5433
ANALYTICS_POSTGRES_USER=analytics_readonly
# Set locally; never commit credentials.
ANALYTICS_POSTGRES_PASSWORD=
ANALYTICS_POSTGRES_DATABASE=f3_staging
