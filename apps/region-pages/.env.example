# Base URL of the F3 API (apps/api), including the /v1 prefix.
F3_API_BASE_URL=http://localhost:3001/v1
F3_CHANNEL=local
# Canonical public origin; drives metadataBase, Open Graph URLs and the sitemap.
# Defaults to https://regions2.f3nation.com when unset.
SITE_URL=http://localhost:3006
# Google Analytics property. Unset = no analytics, except on F3_CHANNEL=prod,
# which reports to the site's existing property (G-44DEXNRMCP).
GA_MEASUREMENT_ID=
NODE_ENV=development
LOG_LEVEL=debug
