{
  "name": "f3-region-pages",
  "type": "module",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port ${F3_REGION_PAGES_PORT:-3006}",
    "build": "next build",
    "start": "next start --port 3006",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "format": "prettier --write . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "test": "vitest --run --coverage",
    "test:watch": "vitest -w",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@acme/logger": "workspace:*",
    "@acme/shared": "workspace:*",
    "@f3nation/health": "workspace:*",
    "@orpc/client": "catalog:",
    "@t3-oss/env-nextjs": "catalog:",
    "lodash": "catalog:",
    "lucide-react": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "server-only": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@acme/api": "workspace:*",
    "@acme/eslint-config": "workspace:*",
    "@acme/prettier-config": "workspace:*",
    "@acme/security-headers": "workspace:*",
    "@acme/tsconfig": "workspace:*",
    "@acme/vitest-config": "workspace:*",
    "@orpc/server": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/lodash": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "postcss": "catalog:",
    "postcss-load-config": "catalog:",
    "prettier": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "prettier": "@acme/prettier-config"
}
