# .env.cloud-run.<staging|prod>
# Copy this file and populate with real values:
#   cp .env.cloud-run.example .env.cloud-run.staging
#   cp .env.cloud-run.example .env.cloud-run.prod

# ── Secrets (pushed to GCP Secret Manager) ──
DATABASE_HOST=host
DATABASE_USER=user
DATABASE_PASSWORD=pass
DATABASE_NAME=dbname

AUTH_SECRET=generate-a-random-secret
AUTH_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\"
EMAIL_SERVER=smtp://apikey:SG.xxxx@smtp.sendgrid.net:587
API_KEY=f3_xxxx

# ── Per-environment plain env vars ──
NEXTAUTH_URL=https://auth.f3nation.com
NEXT_PUBLIC_AUTH_URL=https://auth.f3nation.com
NEXT_PUBLIC_API_URL=https://api.f3nation.com
EMAIL_FROM=noreply@f3nation.com
# Link to the F3 apps directory on auth's home page. Both are optional and the
# values below are the defaults. Staging points the URL at its own directory
# or sets APPS_DIRECTORY_ENABLED=false, so it doesn't send people to
# production apps.
# APPS_DIRECTORY_ENABLED=true
# APPS_DIRECTORY_URL=https://apps.f3nation.com

# Pino log level: trace | debug | info | warn | error | fatal (default: info).
LOG_LEVEL=info
