{
  "name": "f3-auth",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "clean": "rm -rf .next .turbo node_modules",
    "dev": "pnpm next dev -p 3004",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "lint": "eslint .",
    "start": "next start",
    "test": "pnpm with-env vitest --run",
    "typecheck": "tsc --noEmit",
    "add-client": "tsx scripts/add-client.ts",
    "with-env": "dotenv -e .env --"
  },
  "dependencies": {
    "@acme/db": "workspace:*",
    "@acme/shared": "workspace:*",
    "@auth/core": "catalog:",
    "@t3-oss/env-nextjs": "catalog:",
    "drizzle-orm": "catalog:",
    "jose": "catalog:",
    "libphonenumber-js": "catalog:",
    "next": "catalog:",
    "next-auth": "catalog:",
    "next-themes": "catalog:",
    "nodemailer": "catalog:",
    "pg": "catalog:",
    "postgres": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-phone-number-input": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@acme/eslint-config": "workspace:*",
    "@acme/prettier-config": "workspace:*",
    "@acme/tailwind-config": "workspace:*",
    "@acme/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/nodemailer": "catalog:",
    "@types/pg": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "autoprefixer": "catalog:",
    "dotenv-cli": "catalog:",
    "eslint": "catalog:",
    "postcss": "catalog:",
    "prettier": "catalog:",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "prettier": "@acme/prettier-config"
}
