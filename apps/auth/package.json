{
  "name": "f3-auth",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "clean": "rm -rf .next .turbo node_modules",
    "dev": "pnpm next dev -p 3004",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "lint": "eslint .",
    "start": "next start",
    "test": "pnpm with-env vitest --run",
    "typecheck": "tsc --noEmit",
    "add-client": "tsx scripts/add-client.ts",
    "with-env": "dotenv -e .env --"
  },
  "dependencies": {
    "@acme/db": "workspace:*",
    "@acme/shared": "workspace:*",
    "@auth/core": "0.37.2",
    "@t3-oss/env-nextjs": "^0.9.2",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.1",
    "libphonenumber-js": "^1.12.42",
    "next": "^15.3.6",
    "next-auth": "5.0.0-beta.25",
    "next-themes": "^0.4.4",
    "nodemailer": "^6.10.0",
    "pg": "^8.11.3",
    "postgres": "^3.4.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-phone-number-input": "^3.4.16",
    "zod": "^3.25.8"
  },
  "devDependencies": {
    "@acme/eslint-config": "workspace:*",
    "@acme/prettier-config": "workspace:*",
    "@acme/tailwind-config": "workspace:*",
    "@acme/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/nodemailer": "catalog:",
    "@types/pg": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "autoprefixer": "catalog:",
    "dotenv-cli": "catalog:",
    "eslint": "catalog:",
    "postcss": "catalog:",
    "prettier": "catalog:",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "prettier": "@acme/prettier-config"
}
