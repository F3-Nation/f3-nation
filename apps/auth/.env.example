NODE_ENV=development

# -- Database (local Docker Postgres on port 5433) ----------------------------
DATABASE_URL=postgresql://f3local:f3local@localhost:5433/f3nation
DATABASE_HOST=localhost:5433
DATABASE_USER=f3local
DATABASE_PASSWORD=f3local
DATABASE_NAME=f3nation

# -- Auth ---------------------------------------------------------------------
AUTH_SECRET=local-dev-secret-at-least-32-chars-long

# -- API keys (any non-empty string works locally) ----------------------------
API_KEY=local-api-key

# -- Email --------------------------------------------------------------------
# Emails are captured by Mailpit — no mail leaves your machine.
# Open http://localhost:8025 to read anything the app sends.
EMAIL_SERVER=smtp://localhost:1025
EMAIL_FROM=noreply@f3nation.local

# -- Client-side URLs (Next.js public vars) -----------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_AUTH_URL=http://localhost:3004

AUTH_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\"