{
  "name": "f3-me",
  "type": "module",
  "version": "1.0.3",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3003",
    "build": "next build",
    "start": "next start --port 3003",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest --run",
    "test:watch": "vitest -w",
    "test:coverage": "vitest --run --coverage",
    "typecheck": "tsc --noEmit",
    "deploy:variables-secrets:staging": "/usr/bin/env bash scripts/cloud-run-env.sh --env staging",
    "deploy:variables-secrets:prod": "/usr/bin/env bash scripts/cloud-run-env.sh --env prod"
  },
  "dependencies": {
    "@acme/api": "workspace:^0.2.0",
    "@acme/shared": "workspace:^0.1.0",
    "@acme/sso": "workspace:*",
    "@acme/storage": "workspace:*",
    "@acme/ui": "workspace:^0.1.0",
    "@orpc/client": "^1.8.8",
    "@orpc/server": "^1.8.8",
    "clsx": "^2.1.0",
    "jose": "^6.2.1",
    "next": "^15.3.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.2.1",
    "zod": "^3.25.8"
  },
  "devDependencies": {
    "@acme/eslint-config": "workspace:^0.2.0",
    "@acme/tsconfig": "workspace:^0.1.0",
    "@testing-library/jest-dom": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "autoprefixer": "catalog:",
    "eslint": "catalog:",
    "postcss": "catalog:",
    "prettier": "catalog:",
    "tailwindcss": "catalog:",
    "tailwindcss-animate": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
