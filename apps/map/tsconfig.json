{
  "extends": "../../tooling/typescript/base.json",
  "compilerOptions": {
    "lib": ["ES2022", "dom", "dom.iterable"],
    "jsx": "preserve",
    "paths": {
      "~/*": ["./src/*"]
    },
    // Required for .css module type declarations (tooling/typescript/type-extensions.d.ts)
    "allowArbitraryExtensions": true,
    "plugins": [{ "name": "next" }],
    "tsBuildInfoFile": "node_modules/.cache/tsbuildinfo.json",
    "strictNullChecks": true,
    "types": ["@acme/tsconfig/type-extensions", "google.maps"]
  },
  "include": [".", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "vitest.config.ts", ".next"]
}
