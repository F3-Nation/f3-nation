# -- API keys (any non-empty string works locally) ----------------------------
API_KEY=local-api-key

# -- Auth ---------------------------------------------------------------------
AUTH_SECRET=local-dev-secret-at-least-32-chars-long
AUTH_URL=http://localhost:3000

# -- Database (local Docker Postgres on port 5433) ----------------------------
DATABASE_URL=postgresql://f3local:f3local@localhost:5433/f3nation
TEST_DATABASE_URL=postgresql://f3local:f3local@localhost:5433/f3nation_test

# -- Email --------------------------------------------------------------------
# Emails are captured by Mailpit — no mail leaves your machine.
# Open http://localhost:8025 to read anything the app sends.
EMAIL_ADMIN_DESTINATIONS=admin@f3nation.local
EMAIL_FROM=noreply@f3nation.local
EMAIL_SERVER=smtp://localhost:1025

# -- Server runtime URLs (read at request time, not baked into the image) ------
F3_ADMIN_URL=http://localhost:3002
F3_API_BASE_URL=http://localhost:3001
F3_CHANNEL=local

# -- Google Maps API key (for map tile rendering) -----------------------------
# The app will start without this, but the map tiles won't render.
# Get a free API key: https://console.cloud.google.com/google/maps-apis/
# Enable "Maps JavaScript API" for your project.
F3_GOOGLE_API_KEY=your-google-maps-api-key-here

# -- Map app API key (for SSG authentication during `next build`) -------------
# This authenticates in-process router calls during static generation.
# Must match a key in the local DB — `pnpm db:seed:local` inserts "local-map-key".
# Requires Docker + local DB running during `next build`.
F3_MAP_API_KEY=local-map-key

F3_MAP_BASE_URL=http://localhost:3000

# -- Google Cloud Storage (GCS emulator on port 9023) -------------------------
# GCS_EMULATOR_HOST tells the upload route to use fake-gcs-server instead of
# the real GCS API. The three GOOGLE_LOGO_BUCKET_* vars must be non-empty to
# pass validation, but their values are ignored when the emulator is active.
GCS_EMULATOR_HOST=localhost:9023
GOOGLE_LOGO_BUCKET_BUCKET_NAME=f3-public-images
GOOGLE_LOGO_BUCKET_CLIENT_EMAIL=local@local.local
GOOGLE_LOGO_BUCKET_PRIVATE_KEY=local-placeholder-not-used-with-emulator
GOOGLE_LOGO_BUCKET_PROJECT_ID=****

# -- Client-side URLs (Next.js public vars) -----------------------------------
# NEXT_PUBLIC_API_URL and NEXT_PUBLIC_MAP_URL are NOT used by the map app at
# runtime. The map app reads F3_MAP_BASE_URL / F3_API_BASE_URL above instead.
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_CHANNEL=local
NEXT_PUBLIC_GA_MEASUREMENT_ID=****
NEXT_PUBLIC_MAP_URL=http://localhost:3000

# Comma-separated list of webhook URLs to notify on map data changes (optional)
# Format: https://webhook1.com/endpoint,https://webhook2.com/endpoint
NOTIFY_WEBHOOK_URLS_COMMA_SEPARATED=

SUPER_ADMIN_API_KEY=local-super-admin-key
