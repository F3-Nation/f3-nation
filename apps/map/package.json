    "@sentry/nextjs": "^9.15.0",
    "@t3-oss/env-nextjs": "^0.9.2",
    "@tanstack/react-query": "5.90.12",
    "@tanstack/react-query-devtools": "^5.91.1",
    "@vis.gl/react-google-maps": "^1.5.2",
    "axios": "^1.7.4",
    "dayjs": "^1.11.10",
