# .env.cloud-run.<staging|prod>
# Copy this file and populate with real values:
#   cp .env.cloud-run.example .env.cloud-run.staging
#   cp .env.cloud-run.example .env.cloud-run.prod

# ── Secrets (pushed to GCP Secret Manager) ──
API_KEY=<your-staging-api-key>
AUTH_SECRET=<your-staging-auth-secret>
DATABASE_URL=postgresql://user:pass@staging.db.f3nation.com:5432/f3_staging
EMAIL_SERVER=smtp://apikey:SG.xxxx@smtp.sendgrid.net:587
GOOGLE_LOGO_BUCKET_CLIENT_EMAIL=photos-uploader@f3data.iam.gserviceaccount.com
GOOGLE_LOGO_BUCKET_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# ── Per-environment plain env vars ──
EMAIL_ADMIN_DESTINATIONS=admin@f3nation.com
EMAIL_FROM="F3 Support <support@f3nation.com>"
GOOGLE_LOGO_BUCKET_BUCKET_NAME=f3-logos
GOOGLE_LOGO_BUCKET_PROJECT_ID=f3data
NEXT_PUBLIC_API_URL=https://staging.api.f3nation.com
NEXT_PUBLIC_AUTH_URL=https://staging.auth.f3nation.com
NEXT_PUBLIC_MAP_URL=https://staging.map.f3nation.com
NEXT_PUBLIC_CHANNEL=staging
TEST_DATABASE_URL=postgresql://user:pass@staging.db.f3nation.com:5432/f3_test