{
  "name": "f3-api",
  "version": "6.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm with-env next build",
    "clean": "rm -rf .turbo node_modules .next",
    "dev": "TZ=UTC pnpm with-env next dev -p 3001",
    "dev:hono": "TZ=UTC pnpm with-env tsx watch --import ./src/instrument.ts src/server.ts",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "lint": "dotenv -v SKIP_ENV_VALIDATION=1 eslint .",
    "start": "pnpm with-env next start",
    "start:hono": "pnpm with-env tsx --import ./src/instrument.ts src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "pnpm with-env vitest --run --coverage",
    "test:characterization": "pnpm with-env vitest --run --config vitest.characterization.config.ts",
    "test:watch": "pnpm with-env vitest -w",
    "with-env": "dotenv -e .env --"
  },
  "dependencies": {
    "@acme/api": "workspace:*",
    "@acme/logger": "workspace:*",
    "@acme/shared": "workspace:*",
    "@f3nation/health": "workspace:*",
    "@hono/node-server": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@scalar/hono-api-reference": "catalog:",
    "@scalar/nextjs-api-reference": "catalog:",
    "@sentry/nextjs": "catalog:",
    "@sentry/node": "catalog:",
    "@t3-oss/env-core": "catalog:",
    "dotenv-cli": "catalog:",
    "hono": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@acme/auth": "workspace:*",
    "@acme/db": "workspace:*",
    "@acme/eslint-config": "workspace:*",
    "@acme/prettier-config": "workspace:*",
    "@acme/tsconfig": "workspace:*",
    "@acme/vitest-config": "workspace:*",
    "@orpc/client": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "jiti": "catalog:",
    "jose": "catalog:",
    "next-auth": "catalog:",
    "prettier": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "prettier": "@acme/prettier-config"
}
