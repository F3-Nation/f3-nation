{
  "name": "f3-api",
  "version": "5.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm with-env next build",
    "clean": "rm -rf .turbo node_modules .next",
    "dev": "TZ=UTC pnpm with-env next dev -p 3001",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "lint": "dotenv -v SKIP_ENV_VALIDATION=1 eslint .",
    "start": "pnpm with-env next start",
    "typecheck": "tsc --noEmit",
    "test": "pnpm with-env vitest --run --coverage",
    "test:watch": "pnpm with-env vitest -w",
    "with-env": "dotenv -e .env --"
  },
  "dependencies": {
    "@acme/api": "workspace:^0.2.0",
    "@acme/auth": "workspace:^0.1.0",
    "@acme/db": "workspace:^0.1.0",
    "@acme/logger": "workspace:*",
    "@acme/shared": "workspace:^0.1.0",
    "@acme/tailwind-config": "workspace:^0.1.0",
    "@acme/ui": "workspace:^0.1.0",
    "@acme/validators": "workspace:^0.1.0",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@scalar/nextjs-api-reference": "catalog:",
    "@sentry/nextjs": "catalog:",
    "@t3-oss/env-nextjs": "catalog:",
    "dotenv-cli": "catalog:",
    "handlebars": "catalog:",
    "next": "catalog:",
    "next-auth": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@acme/eslint-config": "workspace:^0.2.0",
    "@acme/prettier-config": "workspace:^0.1.0",
    "@acme/tsconfig": "workspace:*",
    "@acme/vitest-config": "workspace:^0.1.0",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "jiti": "catalog:",
    "jsdom": "catalog:",
    "prettier": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "vitest": "catalog:"
  },
  "prettier": "@acme/prettier-config"
}
