# =============================================================================
# F3 Nation — Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values.
# See docs/LOCAL_DEV_SETUP.md for instructions on pulling secrets from GCP.
# =============================================================================

# -- Node environment --------------------------------------------------------
NODE_ENV=development

# -- Database ----------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/DB_NAME
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/DB_NAME_test

# -- Auth --------------------------------------------------------------------
# Required in production, optional in development
AUTH_SECRET=your-auth-secret

# -- API keys ----------------------------------------------------------------
API_KEY=your-api-key
SUPER_ADMIN_API_KEY=your-super-admin-api-key

# -- Email (SendGrid SMTP) --------------------------------------------------
EMAIL_SERVER=smtp://apikey:YOUR_SENDGRID_API_KEY@smtp.sendgrid.net:587
EMAIL_FROM=noreply@f3nation.com
EMAIL_ADMIN_DESTINATIONS=admin@f3nation.com

# -- Google Cloud Storage (logo bucket) -------------------------------------
GOOGLE_LOGO_BUCKET_PRIVATE_KEY=your-gcs-private-key
GOOGLE_LOGO_BUCKET_CLIENT_EMAIL=your-gcs-client-email@project.iam.gserviceaccount.com
GOOGLE_LOGO_BUCKET_BUCKET_NAME=your-bucket-name

# -- Notifications (optional) -----------------------------------------------
# NOTIFY_WEBHOOK_URLS_COMMA_SEPARATED=https://hooks.example.com/webhook1,https://hooks.example.com/webhook2

# -- Client-side (NEXT_PUBLIC_*) ---------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_MAP_URL=http://localhost:3000
NEXT_PUBLIC_AUTH_URL=http://localhost:3004
NEXT_PUBLIC_CHANNEL=local
