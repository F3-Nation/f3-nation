{
  "name": "f3-nation",
  "version": "4.2.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "packageManager": "pnpm@12.9.0+sha512.8f64efa0b792986ca98ae568791bcd7722807e274c4f0c1d9853c62116495c584119db98762a2a5343b1684d361b9ae26fdd16d551666d7635346d3fae830ddd",
  "scripts": {
    "build": "turbo build",
    "ci:local": "pnpm format && pnpm lint && pnpm lint:unused && pnpm typecheck && pnpm build && pnpm test",
    "clean:workspaces": "turbo clean && pnpm clean",
    "clean": "rm -rf .turbo node_modules",
    "commit": "cz",
    "db:drop": "pnpm -F db drop",
    "db:generate_empty": "pnpm -F db generate:empty",
    "db:generate": "pnpm -F db generate",
    "db:migrate:local": "pnpm -F db migrate:local",
    "db:migrate:staging": "pnpm -F db migrate:staging",
    "db:migrate:prod": "pnpm -F db migrate:prod",
    "db:pull": "pnpm -F db pull",
    "db:push": "pnpm -F db push",
    "db:reset": "pnpm -F db reset",
    "db:seed:local": "pnpm -F db seed:local",
    "db:studio": "pnpm -F db studio",
    "dev": "bash scripts/dev.sh",
    "docker:down": "docker compose -f docker-compose.yml down",
    "docker:up": "docker compose -f docker-compose.yml up -d",
    "docker:up:logs": "docker compose -f docker-compose.yml up",
    "env:delete": "bash scripts/delete-env-files.sh",
    "format:fix": "turbo format --continue -- --write --cache --cache-location node_modules/.cache/.prettiercache",
    "format": "turbo format --continue",
    "lint:fix": "turbo lint --continue -- --fix --cache --cache-location node_modules/.cache/.eslintcache",
    "lint:ws": "pnpm dlx sherif@1.1.0",
    "lint:unused": "SKIP_ENV_VALIDATION=true DATABASE_URL=placeholder knip",
    "lint": "bash scripts/lint.sh",
    "local:setup": "bash scripts/local-setup.sh",
    "postinstall": "bash scripts/postinstall-uv-sync.sh",
    "python:install": "uv sync --all-packages",
    "reset-test-db": "turbo run reset-test-db",
    "test": "turbo test",
    "test:characterization": "turbo test:characterization",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@acme/prettier-config": "workspace:^0.1.0",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@commitlint/cz-commitlint": "catalog:",
    "@commitlint/types": "catalog:",
    "@turbo/gen": "catalog:",
    "commitizen": "catalog:",
    "eslint": "catalog:",
    "inquirer": "catalog:",
    "knip": "catalog:",
    "lefthook": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "prettier": "@acme/prettier-config"
}
